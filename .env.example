# Copy to .env beside docker-compose.yml and fill in. .env is gitignored -- it holds the database
# password and the Jira token. Never commit the filled-in copy.
#
#   cp .env.example .env && nano .env && docker compose up -d --build

# ---------------------------------------------------------------------------------------------
# Public hostname. Used for the TLS certificate path, the Entra ID redirect URI, CORS, and the
# links in outgoing emails. Must match the certificate that exists under
# /etc/letsencrypt/live/<this>/ on the host, or the proxy will not start.
# ---------------------------------------------------------------------------------------------
APP_DOMAIN=your-app.example.com

# ---------------------------------------------------------------------------------------------
# Database. The Postgres container creates POSTGRES_DB on first start; the backend connects to it
# over the internal compose network, so the database is never exposed to the host or the internet.
# Changing POSTGRES_PASSWORD after the first start does NOT change it inside an existing volume.
# ---------------------------------------------------------------------------------------------
POSTGRES_DB=delta_migration_tracker
POSTGRES_USER=deltaapp
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Entra ID. Neither value is a secret -- both are public OAuth identifiers that ship in
# client-side JavaScript. They are here rather than hardcoded so one build can point at a
# different tenant.
#
# Leaving AZURE_CLIENT_ID blank makes the backend run FULLY OPEN: every /api route becomes
# permitAll with no authentication, and it fails silently rather than loudly. Never deploy blank.
#
# The placeholders below are all-zero GUIDs rather than empty values, and that choice matters: a
# blank AZURE_CLIENT_ID is the dangerous failure (silently unauthenticated), while a wrong one fails
# loudly at token validation and nobody gets in. If you copy this file without editing it, you want
# the loud failure. Get the real values from the app registration, or from GitHub Settings.
# ---------------------------------------------------------------------------------------------
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Blank means the client-side domain check is skipped and the app_users allowlist governs alone.
AZURE_ALLOWED_EMAIL_DOMAIN=
AZURE_REQUIRE_ALLOWLIST=true
AZURE_AUTO_PROVISION_DOMAIN=yourdomain.com

# Seeded as the single ADMIN row, and ONLY into a completely empty app_users table. Blank skips
# seeding, which means nobody can sign in.
#
# Left as a placeholder rather than a real address on purpose: this repository is public, and a real
# one here is both scraped for spam and a named phishing target -- it identifies the ADMIN account of
# a tool holding customer migration data. Every other value in this file is either public by
# architecture (the Entra ID identifiers ship inside the JavaScript bundle) or harmless; an
# individual's address is neither.
APP_FIRST_ADMIN_EMAIL=first.admin@yourdomain.com

# ---------------------------------------------------------------------------------------------
# Hotjar Site ID, digits only (Settings -> Sites & Organizations in Hotjar).
#
# Blank disables Hotjar entirely: no script requested, no session recorded. Not a secret -- it
# ships in client-side JavaScript. Baked into the bundle at build time, so changing it requires
# `docker compose up -d --build frontend`, not just a restart.
# ---------------------------------------------------------------------------------------------
HOTJAR_SITE_ID=

# ---------------------------------------------------------------------------------------------
# Mail. A blank password disables sending and logs a warning rather than failing.
# ---------------------------------------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Ticketing system (Neutara Technologies Ticketing -- replaced Jira on 2026-08-18). The API token IS
# a real secret: it is a bearer token that authenticates as one specific user, so rotate it if it
# ever leaves this file. Generate one from your profile in the ticketing UI.
#
# There is no *_EMAIL setting any more -- the bearer token identifies the user by itself.
# ---------------------------------------------------------------------------------------------
TICKETING_BASE_URL=https://ticketing.example.com
TICKETING_API_TOKEN=

# ---------------------------------------------------------------------------------------------
# Metabase -- where the migration data itself lives, one database per customer engagement. Read for
# a project's processed/conflict figures. Blank disables the integration: the databases endpoint
# returns a clear "isn't configured" message and nothing else is affected.
#
# METABASE_API_KEY is preferred (Metabase 0.49+, Admin > Authentication > API keys): scoped,
# revocable, and it keeps a person's password out of this file. The username/password pair is a
# fallback because API keys are an admin-enabled feature that may be switched off. If both are set,
# the key wins. BOTH THE KEY AND THE PASSWORD ARE REAL SECRETS.
# ---------------------------------------------------------------------------------------------
METABASE_BASE_URL=https://metabase.cloudfuze.com
METABASE_API_KEY=
METABASE_USERNAME=
METABASE_PASSWORD=
