# NOTE: backend/src/main/resources/application.properties is deliberately NOT ignored. It is the
# app's real configuration and the repo does not build without it. This line used to read
# "backend/application.properties", which matches no file that has ever existed here -- it implied a
# protection that was not in force. Every secret-shaped value in that file MUST stay a ${ENV_VAR:default}
# placeholder; the moment a literal password or API token is pasted in, it gets committed. Put real
# credentials in the environment, never in that file.
.env
.env.local

# Real, filled-in local backend config. Spring loads ./application.properties (i.e. this path, when
# the app is run from backend/) at HIGHER precedence than the classpath copy, so this is where a
# developer's real credentials actually end up. It is ignored precisely BECAUSE it holds literal
# secrets -- that is the division of labour with the tracked
# backend/src/main/resources/application.properties above, which must only ever hold
# ${ENV_VAR:default} placeholders. Do not "clean this up" by deleting the line again: unlike the
# 2026-08-18 removal noted above (which dropped a line matching no file), this file DOES exist and
# DOES contain live tokens.
backend/application.properties

# Build output
backend/target/
frontend/build/
frontend/node_modules/

# Runtime data -- not source, shouldn't be committed
backend/uploads/
db_backups/

# Local run logs
*.log

# Personal Claude Code permissions -- not shared config
.claude/settings.local.json

# Personal Claude Code notes -- not shared config
CLAUDE.local.md
.gstack/
PR_DESCRIPTION.md

# Timestamped copies of the compose file the deploy replaces on its one-time migration (see
# .github/workflows/ci-cd.yml). Never commit one: the hand-written file it preserves carries the real
# Entra ID pair in its frontend build args, and committing it would put those straight back into a
# public repository.
docker-compose.yml.pre-ci-*

# Generated PDFs of the docs/ markdown sources (built via /make-pdf). The .md is the source of
# truth and is committed; the PDF is a build artifact that would churn on every doc edit.
docs/*.pdf
