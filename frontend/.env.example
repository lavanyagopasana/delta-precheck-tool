# Copy this file to .env.local and fill in the values from your Azure AD (Entra ID) app registration.
# Leave them unset (or delete .env.local) to run the app with no sign-in, as before.

REACT_APP_AZURE_CLIENT_ID=

# Required if the app registration's "Supported account types" is single-tenant ("Accounts in
# this organizational directory only"). Leave blank if it's multi-tenant ("Accounts in any
# organizational directory") -- it falls back to the generic /organizations endpoint.
REACT_APP_AZURE_TENANT_ID=

REACT_APP_AZURE_REDIRECT_URI=http://localhost:3000

# Only accounts with this email domain are allowed in (enforced by the app, not by Azure).
REACT_APP_ALLOWED_EMAIL_DOMAIN=cloudfuze.com
