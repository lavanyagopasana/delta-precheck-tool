# Copy this file to .env.local and fill in the values from your Azure AD (Entra ID) app registration.
# Leave them unset (or delete .env.local) to run the app with no sign-in, as before.

REACT_APP_AZURE_CLIENT_ID=

# Required if the app registration's "Supported account types" is single-tenant ("Accounts in
# this organizational directory only"). Leave blank if it's multi-tenant ("Accounts in any
# organizational directory") -- it falls back to the generic /organizations endpoint.
REACT_APP_AZURE_TENANT_ID=

# Where Entra ID sends the user back after sign-in. Leave blank -- it defaults to whatever origin
# the app is served from, which is correct both locally and in production. Set it only to override
# that (e.g. a path-prefixed or proxied deploy). Whatever it resolves to must be registered on the
# app registration under Authentication -> Single-page application, or sign-in fails with AADSTS50011.
REACT_APP_AZURE_REDIRECT_URI=

# Only accounts with this email domain are allowed in (enforced by the app, not by Azure).
REACT_APP_ALLOWED_EMAIL_DOMAIN=cloudfuze.com

# Backend origin (no trailing slash, no /api suffix). Leave unset for local dev to use
# http://localhost:8081. REQUIRED for a production build if the backend is on a different origin
# than the frontend -- react-scripts inlines this value into the bundle at build time, so setting it
# on the server after `npm run build` has no effect. A production build with no value falls back to
# the page's own origin and logs an error to the console.
REACT_APP_API_BASE=
